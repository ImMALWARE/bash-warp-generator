run = ["bash", "-lc", "echo 'Выберите скрипт:'; echo '1) WARP для AmneziaWG'; echo '2) WARP MASQUE для Mihomo/Clash'; read -r -p 'Введите 1 или 2: ' choice; if [ \"$choice\" = \"2\" ]; then bash masque_generator.sh; else bash warp_generator.sh; fi"]
entrypoint = "warp_generator.sh"
modules = ["bash"]

hidden = [".config"]

[nix]
channel = "stable-24_05"

[languages.bash]
pattern = "**/*.sh"
syntax = "bash"

[deployment]
run = ["bash", "-lc", "bash ${SCRIPT:-warp_generator.sh}"]
deploymentTarget = "cloudrun"